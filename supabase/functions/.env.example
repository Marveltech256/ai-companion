# SERVER ONLY. Never copy these values into Flutter configuration.
FIREBASE_PROJECT_ID=ai-personal-companion
OPENAI_API_KEY=
# Low-cost current-model candidate. Verify account access with a live request.
OPENAI_MODEL=gpt-6-luna
# Optional; defaults to OPENAI_MODEL.
OPENAI_MEMORY_MODEL=
# Optional semantic reranking over up to 32 already-owned candidates; off when empty.
# Uses a separate Responses request with a five-second budget and lexical fallback.
OPENAI_RETRIEVAL_MODEL=
# Optional server-only Gemini backup. Activated only with a key and model.
# Set GEMINI_BACKUP_ENABLED=false to disable cross-provider failover.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_MEMORY_MODEL=gemini-3.5-flash-lite
GEMINI_RETRIEVAL_MODEL=
GEMINI_BACKUP_ENABLED=true
# Voice chooses a configured OpenAI operation first, otherwise the Gemini operation.
# Gemini models below were verified with synthetic audio. Paid API setup is
# required before sending customer personal information; billing is separate.
GEMINI_TRANSCRIPTION_MODEL=gemini-3.5-flash-lite
GEMINI_SPEECH_MODEL=gemini-3.8-flash-lite-tts
GEMINI_SPEECH_VOICE=Kore
# Optional OpenAI voice operations; verify account access before configuring.
OPENAI_TRANSCRIPTION_MODEL=
OPENAI_SPEECH_MODEL=
OPENAI_SPEECH_VOICE=marin
# SERVER ONLY JSON credential, with users.get/users.delete and FCM send permissions.
# Configure through the server secret manager; do not paste a private key in chat.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Long random server secret for scheduled workers, stored in the scheduler/Vault.
SCHEDULER_SECRET=
# Exact comma-separated browser origins, no wildcard.
ALLOWED_ORIGINS=http://localhost:52100
# Managed Supabase Edge runtime supplies these; needed for a local server.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional Google Play billing, intentionally inactive during internal testing.
# Separate credential with Android Publisher app permissions; never reuse the
# Firebase identity or ship this credential to Flutter.
BILLING_FEATURE_ENABLED=false
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
# Random 32-byte base64url server key for encrypted purchase tokens.
BILLING_TOKEN_ENCRYPTION_KEY=
# Exact authenticated Pub/Sub push audience and expected service-account email.
GOOGLE_PLAY_RTDN_AUDIENCE=
GOOGLE_PLAY_RTDN_SERVICE_ACCOUNT_EMAIL=
# Temporary private review-code entry. Keep the plaintext code out of the app.
# SQL review_configuration.enabled must also be true. Set it false to revoke
# access immediately for both Edge routes and owned RLS reads.
REVIEW_GUEST_ENABLED=false
REVIEW_GUEST_CODE_HASH=
