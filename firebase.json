{
  "hosting": {
    "site": "ai-personal-companion-privacy",
    "public": "site/dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "site-manifest.json"
    ],
    "predeploy": [
      "node tools/build_public_site.mjs"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "Cache-Control",
            "value": "no-store"
          },
          {
            "key": "Permissions-Policy",
            "value": "camera=(), microphone=(), geolocation=()"
          },
          {
            "key": "Content-Security-Policy",
            "value": "default-src 'self'; script-src 'self' https://www.gstatic.com https://apis.google.com; style-src 'self'; font-src 'self'; img-src 'self' data:; connect-src 'self' https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://www.googleapis.com https://rvokidwyzwygpzzkpqck.supabase.co; frame-src https://ai-personal-companion.firebaseapp.com https://accounts.google.com; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
          }
        ]
      }
    ],
    "redirects": [
      {
        "source": "/privacy.html",
        "destination": "/privacy-policy.html",
        "type": 301
      }
    ]
  },
  "auth": {
    "providers": {
      "emailPassword": true,
      "anonymous": false,
      "googleSignIn": {
        "oAuthBrandDisplayName": "Ai Companion",
        "supportEmail": "atalyebamarvin4@gmail.com",
        "authorizedRedirectUris": [
          "https://ai-personal-companion.firebaseapp.com/__/auth/handler"
        ]
      }
    }
  }
}
